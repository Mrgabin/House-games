rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "galtiergabin76@gmail.com" ||
        request.auth.token.email == "ytgabgal@gmail.com"
      );
    }

    // Games collection: Anyone can read, and admins can manage/delete games in the library
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Users collection: Public profiles, friend search, friend requests & status
    match /users/{userId} {
      // Allow public read of profiles and playtimes so all players can visit showcases and calculate levels
      allow read: if true;
      allow write: if true;

      // Subcollection for user saves (capture, upload, rename, delete)
      match /saves/{saveId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Subcollection for playtime tracking and stats (public for Vitrine ONL showcase)
      match /playtimes/{gameId} {
        allow read: if true;
        allow write: if isOwner(userId) || isAdmin();
      }

      // Subcollection for friend relationships
      match /friends/{friendId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
