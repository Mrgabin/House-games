rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "galtiergabin76@gmail.com" ||
        request.auth.token.email == "ytgabgal@gmail.com"
      );
    }

    // Games collection: Anyone can read games in the library
    match /games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    // Users collection: Private user profiles and favorite games
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }
  }
}
